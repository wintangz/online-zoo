{
  "extends": "@online-zoo/config/tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "*.mjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "playwright-report", "test-results"]
}

